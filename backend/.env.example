# Copy to .env and adjust. Every value has a development default in config/settings.py.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Origins allowed to post the admin site's forms when served under a domain, e.g. https://admin.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://aj:aj@localhost:5434/aj_jeweler
MEDIA_ROOT=media
# Access tokens are short; the refresh token keeps a phone signed in for a shift.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Push notifications. Path to the Firebase service-account JSON key for project
# aj-jeweler-notification (Firebase console > Project settings > Service accounts
# > Generate new private key). Keep the key OUTSIDE the repository. Leave empty
# to run with notifications off — everything else still works.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=aj-jeweler-notification
# thread (default) | inline | command
PUSH_DELIVERY=thread

# Photos and receipt PDFs. Leave empty to keep them on local disk (MEDIA_ROOT).
# Cloudinary console > Settings > API Keys: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Folder for every asset; use a different one per environment (aj-jeweler, aj-jeweler-dev).
CLOUDINARY_FOLDER=aj-jeweler

# Who may use the Django admin site. Default: superuser only. superuser,admin is a temporary bridge
# while phones are updated for the new roles (README, "Deploying the Supervisor and Superuser roles").
DJANGO_ADMIN_SITE_ROLES=superuser
