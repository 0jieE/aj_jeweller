# Copy to .env.production on the server and fill in. Never commit the filled
# copy — it holds the keys to the shop's records.

# --- Django ---------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# The addresses phones and browsers use to reach this server.
DJANGO_ALLOWED_HOSTS=aj.example.com,192.168.0.107
# Only needed to log into the Django admin over a domain.
DJANGO_CSRF_TRUSTED_ORIGINS=https://aj.example.com

# --- Database -------------------------------------------------------------
POSTGRES_DB=aj_jeweler
POSTGRES_USER=aj
POSTGRES_PASSWORD=

# --- Sessions -------------------------------------------------------------
# An access token is short; the refresh token keeps a phone signed in for a
# shift without asking for the PIN again.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# --- Push notifications ---------------------------------------------------
# The service-account key stays on the host. Put its path here; compose
# mounts it read-only at the path below. Leave both empty to run with
# notifications off — everything else still works.
FIREBASE_CREDENTIALS_HOST_FILE=/srv/secrets/aj-jeweler-firebase.json
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase.json
FIREBASE_PROJECT_ID=aj-jeweler-notification
PUSH_DELIVERY=thread

# --- nginx ----------------------------------------------------------------
HTTP_PORT=80
